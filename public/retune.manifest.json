{
  "version": 2,
  "components": {
    "LimitedTimeDeal": {
      "props": {
        "price": { "type": "string" },
        "regular": { "type": "string" },
        "liveWas": { "type": "number" },
        "upcomingWas": { "type": "number" },
        "off": { "type": "number" },
        "save": { "type": "number" },
        "notified": { "type": "boolean" },
        "animatePrice": { "type": "boolean" }
      }
    },
    "DealRevealModal": {
      "props": {
        "price": { "type": "string" },
        "remaining": { "type": "number" }
      }
    },
    "MainInfo": {
      "props": {
        "productName": { "type": "string" },
        "notified": { "type": "boolean" },
        "animateDealPrice": { "type": "boolean" }
      }
    },
    "TopNav": {
      "props": {
        "state": { "type": "enum", "values": [1, 2] }
      }
    },
    "BottomNav": {
      "props": {
        "showDeal": { "type": "boolean" },
        "notified": { "type": "boolean" }
      }
    },
    "BottomDeal": {
      "props": {
        "notified": { "type": "boolean" }
      }
    },
    "Stars": {
      "props": {
        "value": { "type": "number" },
        "size": { "type": "number" }
      }
    },
    "VariantPicker": {
      "state": {
        "version": { "type": "enum", "values": ["UK 3 PIN", "US 2 PIN"] },
        "model": { "type": "enum", "values": ["UK 3 PIN", "US 2 PIN"] },
        "colour": { "type": "enum", "values": ["735 GaN", "735 GaN II", "736 GaN II", "736 GaN"] }
      }
    },
    "ProductDetails": {
      "state": {
        "open": { "type": "enum", "values": ["Overview", "Highlights", "Specifications"] }
      }
    }
  },
  "tokens": {
